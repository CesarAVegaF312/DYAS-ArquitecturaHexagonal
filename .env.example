# Variables de entorno del sistema. Copie este archivo como .env y cambie las claves:
#   cp .env.example .env
# El archivo .env está en .gitignore y nunca se sube al repositorio.

# ---------- Adaptador de persistencia ----------
# Valores: memoria | postgres
PERSISTENCIA=memoria

# ---------- Base de datos ----------
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=cambie-esta-clave-local

# ---------- Puertos en su máquina ----------
APP_PORT=8080
DB_PORT=5432
